# Salin file ini jadi `.env`, lalu isi dari Supabase: Settings → API Keys.
# VITE_SUPABASE_ANON_KEY menerima publishable key (sb_publishable_…) maupun anon
# key lama (eyJ…). Supabase memensiunkan anon key akhir 2026, jadi pakai yang baru.
# Self-hosted: ambil SUPABASE_PUBLIC_URL dan ANON_KEY dari .env server Supabase.
#
# Kedua nilai ini IKUT TERTULIS ke dalam bundel yang dikirim ke browser — itu
# memang wajar untuk key ini. Yang menjaga data bukan kerahasiaan key ini, tapi
# Row Level Security di tabelnya. Jangan pernah menaruh secret key (sb_secret_…)
# atau service_role key di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
