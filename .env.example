# Salin file ini jadi `.env`, lalu isi dari Supabase: Settings → API.
#
# Kedua nilai ini IKUT TERTULIS ke dalam bundel yang dikirim ke browser — itu
# memang wajar untuk anon key. Yang menjaga data bukan kerahasiaan key ini, tapi
# Row Level Security di tabelnya. Jangan pernah menaruh service_role key di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
